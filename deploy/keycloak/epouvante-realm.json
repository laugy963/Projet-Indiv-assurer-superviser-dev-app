{
  "realm": "epouvante",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 120,
  "roles": {
    "realm": [
      { "name": "membre", "description": "Inscrit de l'espace communautaire" },
      { "name": "moderateur", "description": "Peut retirer une annonce" }
    ]
  },
  "clients": [
    {
      "clientId": "tests",
      "name": "Client réservé aux tests automatisés",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-api-epouvante",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api-epouvante",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
