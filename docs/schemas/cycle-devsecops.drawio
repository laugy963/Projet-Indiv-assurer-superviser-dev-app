  <diagram name="Cycle DevSecOps" id="cycle-devsecops">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dev" value="Développement : la sécurité entre dans le code" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;container=1;collapsible=0;spacingTop=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1180" height="190" as="geometry" /></mxCell>
        <mxCell id="ops" value="Exploitation : la sécurité tient dans la durée" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;container=1;collapsible=0;spacingTop=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1180" height="190" as="geometry" /></mxCell>
        <mxCell id="planifier" value="&lt;b&gt;1. Planifier&lt;/b&gt;&lt;br&gt;Exigences de sécurité au backlog&lt;br&gt;Analyse de risques&lt;br&gt;Modélisation des menaces" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="dev"><mxGeometry x="25" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="coder" value="&lt;b&gt;2. Coder&lt;/b&gt;&lt;br&gt;Règles de codage sûr&lt;br&gt;Lint de sécurité&lt;br&gt;Aucun secret dans le code&lt;br&gt;Revue par pull request" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="dev"><mxGeometry x="315" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="construire" value="&lt;b&gt;3. Construire&lt;/b&gt;&lt;br&gt;SAST, SCA, détection de secrets&lt;br&gt;Image minimale, non root&lt;br&gt;Versions d'outils fixées" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="dev"><mxGeometry x="605" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="tester" value="&lt;b&gt;4. Tester&lt;/b&gt;&lt;br&gt;Tests des contrôles d'accès&lt;br&gt;Scan de l'image&lt;br&gt;DAST (cible)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="dev"><mxGeometry x="895" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="livrer" value="&lt;b&gt;5. Livrer&lt;/b&gt;&lt;br&gt;Image étiquetée par commit&lt;br&gt;Registre à accès restreint&lt;br&gt;Validation humaine" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="ops"><mxGeometry x="895" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="deployer" value="&lt;b&gt;6. Déployer&lt;/b&gt;&lt;br&gt;Secrets du cluster&lt;br&gt;HTTPS, NetworkPolicy&lt;br&gt;Moindre privilège" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="ops"><mxGeometry x="605" y="42" width="260" height="124" as="geometry" /></mxCell>
        <mxCell id="exploiter" value="&lt;b&gt;7. Exploiter&lt;/b&gt;&lt;br&gt;Authentification et rôles&lt;br&gt;Scan planifié chaque nuit&lt;br&gt;Mises à jour automatiques (cible)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="ops"><mxGeometry x="315" y="42" width="260" height="124" as="geometry" /></mxCell>
