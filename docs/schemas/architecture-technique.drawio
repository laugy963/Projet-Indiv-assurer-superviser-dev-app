        <mxCell id="e26" value="5 · AMQP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=0.5;exitY=1;entryX=1;entryY=0.227;" edge="1" parent="1" source="rabbitmq" target="service-notifications"><mxGeometry x="0.25" relative="1" as="geometry" /></mxCell>
        <mxCell id="e27" value="6 · SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=1;exitY=0.773;entryX=0;entryY=0.7;" edge="1" parent="1" source="service-notifications" target="base-notifications"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e28" value="7 · REST + jeton" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=1;exitY=0.871;entryX=0;entryY=0.5;" edge="1" parent="1" source="traefik" target="service-notifications"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e29" value="Clés publiques du jeton" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="services" target="keycloak"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e30" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="keycloak" target="base-keycloak"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e31" value="Certificat TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cert-manager" target="traefik"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e32" value="Collecte /metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=0.5;exitY=0;entryX=0.483;entryY=1;" edge="1" parent="1" source="prometheus" target="services"><mxGeometry x="0.5" relative="1" as="geometry" /></mxCell>
        <mxCell id="e33" value="Requêtes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="grafana" target="prometheus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legende-flux" value="Flux principal : publier une annonce, notifier les membres intéressés" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;container=1;collapsible=0;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="1100" height="200" as="geometry" /></mxCell>
        <mxCell id="v35" value="&lt;b&gt;1&lt;/b&gt; · Le membre s'authentifie auprès de Keycloak et reçoit un jeton d'accès signé (JWT)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="32" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v36" value="&lt;b&gt;2&lt;/b&gt; · Il publie une annonce : appel REST en HTTPS, jeton dans l'en-tête Authorization." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="55" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v37" value="&lt;b&gt;3&lt;/b&gt; · Le service annonces vérifie le jeton, le rôle et les données, puis enregistre l'annonce." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="78" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v38" value="&lt;b&gt;4&lt;/b&gt; · Il publie l'événement « annonce.publiee » sur le broker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="101" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v39" value="&lt;b&gt;5&lt;/b&gt; · Le broker remet l'événement au service notifications, qui en accuse réception après traitement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="124" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v40" value="&lt;b&gt;6&lt;/b&gt; · Le service notifications enregistre une notification pour chaque membre intéressé par la catégorie." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="147" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="v41" value="&lt;b&gt;7&lt;/b&gt; · Le membre intéressé consulte ses notifications." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-flux"><mxGeometry x="12" y="170" width="1070" height="22" as="geometry" /></mxCell>
        <mxCell id="legende-traits" value="Légende" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;container=1;collapsible=0;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1140" y="910" width="560" height="200" as="geometry" /></mxCell>
        <mxCell id="l43" value="" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;html=1;" edge="1" parent="legende-traits"><mxGeometry relative="1" as="geometry"><mxPoint x="16" y="48" as="sourcePoint" /><mxPoint x="66" y="48" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="v44" value="Flux principal, numéroté dans l'ordre" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-traits"><mxGeometry x="80" y="36" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="l45" value="" style="endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=6 4;html=1;" edge="1" parent="legende-traits"><mxGeometry relative="1" as="geometry"><mxPoint x="16" y="80" as="sourcePoint" /><mxPoint x="66" y="80" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="v46" value="Flux technique : la flèche part de celui qui appelle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-traits"><mxGeometry x="80" y="68" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="v47" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="legende-traits"><mxGeometry x="26" y="102" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="v48" value="Base de données" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-traits"><mxGeometry x="80" y="105" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="v49" value="Protocoles : OIDC (authentification), REST (API en JSON), AMQP (messages), SQL (bases)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="legende-traits"><mxGeometry x="16" y="142" width="530" height="44" as="geometry" /></mxCell>
