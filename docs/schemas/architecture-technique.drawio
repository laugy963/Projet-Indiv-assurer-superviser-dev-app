        <mxCell id="acteur-texte" value="&lt;b&gt;Membre ou modérateur&lt;/b&gt;&lt;br&gt;Client HTTP : tests d'appel, k6, future interface web" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="zone-internet"><mxGeometry x="10" y="395" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="traefik" value="&lt;b&gt;Traefik&lt;/b&gt;&lt;br&gt;Contrôleur Ingress&lt;br&gt;&lt;br&gt;Point d'entrée unique&lt;br&gt;Termine le HTTPS&lt;br&gt;Routage par nom d'hôte et par chemin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="zone-cluster"><mxGeometry x="40" y="50" width="190" height="580" as="geometry" /></mxCell>
        <mxCell id="cert-manager" value="&lt;b&gt;cert-manager&lt;/b&gt;&lt;br&gt;Émet et renouvelle le certificat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="zone-cluster"><mxGeometry x="40" y="690" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;Serveur d'identité (OpenID Connect)&lt;br&gt;Rôles : membre, modérateur" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="zone-cluster"><mxGeometry x="430" y="60" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="services" value="Services métier · NestJS, TypeScript&lt;br&gt;1 à N pods chacun (HPA)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;container=1;collapsible=0;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="zone-cluster"><mxGeometry x="410" y="210" width="300" height="420" as="geometry" /></mxCell>
        <mxCell id="service-annonces" value="&lt;b&gt;Service annonces&lt;/b&gt;&lt;br&gt;Publier, lister, retirer&lt;br&gt;Vérifie le jeton et le rôle&lt;br&gt;Émet « annonce.publiee »" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="services"><mxGeometry x="20" y="55" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="service-notifications" value="&lt;b&gt;Service notifications&lt;/b&gt;&lt;br&gt;Centres d'intérêt, notifications&lt;br&gt;Vérifie le jeton et le rôle&lt;br&gt;Consomme « annonce.publiee »" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="services"><mxGeometry x="20" y="290" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="rabbitmq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;Broker de messages&lt;br&gt;Exchange « annonces » (topic)&lt;br&gt;File durable, accusé de réception" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="zone-cluster"><mxGeometry x="810" y="390" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="postgresql" value="PostgreSQL · une instance&lt;br&gt;une base et un compte par usage" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;container=1;collapsible=0;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="zone-cluster"><mxGeometry x="1140" y="10" width="260" height="620" as="geometry" /></mxCell>
