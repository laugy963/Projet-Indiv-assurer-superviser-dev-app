        <mxCell id="e23" value="2 · REST + jeton" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=1;exitY=0.466;entryX=0;entryY=0.5;" edge="1" parent="1" source="traefik" target="service-annonces"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e24" value="3 · SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#1a1a1a;exitX=1;exitY=0.227;entryX=0;entryY=0.3;" edge="1" parent="1" source="service-annonces" target="base-annonces"><mxGeometry relative="1" as="geometry" /></mxCell>
