        <mxCell id="grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;Tableaux de bord : p95, erreurs, pods" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="observabilite"><mxGeometry x="370" y="45" width="250" height="65" as="geometry" /></mxCell>
        <mxCell id="mesures-cluster" value="&lt;b&gt;Dans tout le cluster&lt;/b&gt;&lt;br&gt;NetworkPolicy : tout est fermé, chaque flux est ouvert un par un&lt;br&gt;Secrets Kubernetes : aucun mot de passe dans le dépôt&lt;br&gt;Conteneurs non root, ressources limitées" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="zone-cluster"><mxGeometry x="1100" y="680" width="310" height="130" as="geometry" /></mxCell>
